---
import fs from "node:fs";
import { parseMdDocument, parseBodySections, contentEdit } from "astro-inline-editor";
import { packageReadmePath, packageReadmeFile } from "../../readme-path.mjs";

const raw = fs.readFileSync(packageReadmePath, "utf-8");

const FILE = packageReadmeFile;
const doc = parseMdDocument(raw, { requireFrontmatter: false });

let title = "astro-inline-editor";
let bodyForSections = doc.body.trim();
const firstLine = bodyForSections.split("\n")[0] ?? "";
if (firstLine.startsWith("# ")) {
  title = firstLine.slice(2).trim();
  bodyForSections = bodyForSections.slice(firstLine.length).trimStart();
}

const sections = parseBodySections(bodyForSections);
const intro = sections[0]?.heading ? null : sections[0];
const contentSections = intro ? sections.slice(1) : sections;
const introOffset = intro ? 1 : 0;

const edit = (path, html = false) => contentEdit(FILE, path, html);

function isCodeFence(text) {
  return text.trimStart().startsWith("```");
}

function codeFromFence(text) {
  const lines = text.trimEnd().split("\n");
  if (lines.length < 2) return text;
  const end = lines[lines.length - 1].trim() === "```" ? -1 : lines.length;
  return lines.slice(1, end).join("\n");
}

function displayMarkdownLinks(text) {
  let t = text.trim();
  if (t.startsWith("*") && t.endsWith("*") && !t.startsWith("**")) {
    t = t.slice(1, -1);
  }
  return t.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>',
  );
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        --charcoal: #2d2d2d;
        --muted: #6b6b6b;
        --warm: #fcfcfb;
        --warm-light: #fefefd;
        --warm-dark: #f9f9f7;
        --border: #eaeaea;
        --lime: #c4f547;
        --link: #2563eb;
        --link-hover: #1d4ed8;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        color: var(--charcoal);
        background: var(--warm);
        line-height: 1.65;
      }
      .site-header {
        background: var(--warm-light);
        border-bottom: 1px solid #eaeaea;
        padding: 1rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        font-size: 0.875rem;
      }
      .site-header strong { color: var(--charcoal); }
      .site-header nav { display: flex; flex-wrap: wrap; gap: 1rem; }
      .site-header a { color: var(--muted); text-decoration: none; }
      .site-header a:hover { color: var(--charcoal); }
      .hero {
        background: var(--warm-dark);
        color: var(--charcoal);
        padding: 3rem 1.5rem 2.5rem;
        border-bottom: 1px solid var(--border);
      }
      .hero-inner { max-width: 42rem; margin: 0 auto; }
      .hero h1 {
        margin: 0 0 1.25rem;
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .hero p {
        margin: 0 0 1rem;
        font-size: 1.0625rem;
        color: #374151;
      }
      .hero p:last-child { margin-bottom: 0; }
      .hero a,
      .hero a:visited {
        color: var(--link);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .hero a:hover { color: var(--link-hover); }
      .hero-credit {
        font-size: 0.9375rem;
        color: var(--muted);
        font-style: italic;
        margin-bottom: 1.25rem;
      }
      .format-badge {
        display: inline-block;
        background: var(--lime);
        color: var(--charcoal);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        margin-bottom: 1rem;
      }
      main {
        max-width: 42rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 4rem;
        background: var(--warm-light);
      }
      .prose h2 {
        font-size: 1.375rem;
        font-weight: 800;
        margin: 2.5rem 0 0.75rem;
        color: var(--charcoal);
      }
      .prose h2:first-child { margin-top: 0; }
      .prose p {
        color: #374151;
        margin: 0 0 1rem;
      }
      .prose strong { color: var(--charcoal); }
      .prose a {
        color: var(--link);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .prose a:hover { color: var(--link-hover); }
      .prose pre {
        background: #1e1e2e;
        color: #cdd6f4;
        padding: 1rem 1.25rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        font-size: 0.8125rem;
        line-height: 1.5;
        margin: 0 0 1rem;
      }
      .prose ol, .prose ul {
        margin: 0 0 1rem;
        padding-left: 1.5rem;
        color: #374151;
      }
      .prose li { margin-bottom: 0.35rem; }
      .prose .code-block { margin: 0 0 1rem; }
      .edit-hint {
        margin-top: 2.5rem;
        padding: 1rem 1.25rem;
        background: var(--warm-dark);
        border: 1px dashed #d1d5db;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        color: var(--muted);
      }
      .edit-hint code { font-size: 0.8125rem; color: var(--charcoal); }
    </style>
  </head>
  <body>
    <div class="site-header">
      <strong>{title}</strong>
      <nav>
        <a href="/riverdale/">JSON example</a>
        <a href="/riverdale-year-two/">Markdown example</a>
      </nav>
    </div>

    <header class="hero">
      <div class="hero-inner">
        <span class="format-badge">README.md · editable in dev</span>
        <h1 {...edit("title")}>{title}</h1>
        {
          intro?.paragraphs.map((paragraph, pi) => {
            if (isCodeFence(paragraph)) {
              return (
                <pre class="code-block" {...edit(`body.0.paragraphs.${pi}`)}><code>{codeFromFence(paragraph)}</code></pre>
              );
            }
            const isCredit = pi === 0 && paragraph.includes("](http");
            if (isCredit) {
              return (
                <p
                  {...edit(`body.0.paragraphs.${pi}`)}
                  class="hero-credit"
                  data-edit-raw={paragraph}
                  set:html={displayMarkdownLinks(paragraph)}
                />
              );
            }
            return <p {...edit(`body.0.paragraphs.${pi}`)}>{paragraph}</p>;
          })
        }
      </div>
    </header>

    <main class="prose">
      {
        contentSections.map((section, si) => {
          const sectionIndex = si + introOffset;
          return (
            <section>
              <h2 {...edit(`body.${sectionIndex}.heading`)}>{section.heading}</h2>
              {
                section.paragraphs.map((paragraph, pi) =>
                  isCodeFence(paragraph) ? (
                    <pre class="code-block" {...edit(`body.${sectionIndex}.paragraphs.${pi}`)}><code>{codeFromFence(paragraph)}</code></pre>
                  ) : (
                    <p {...edit(`body.${sectionIndex}.paragraphs.${pi}`)}>{paragraph}</p>
                  )
                )
              }
            </section>
          );
        })
      }

      <p class="edit-hint">
        This page is the package README. Toggle <strong>Inline Editor</strong> in the Astro dev toolbar,
        click any tagged text, and edits save to the package <code>README.md</code>.
      </p>
    </main>
  </body>
</html>
