---
import story from "../data/content.json";
import { contentEdit } from "astro-inline-editor";

const FILE = "src/data/content.json";
const edit = (path, html = false) => contentEdit(FILE, path, html);

const statColors = ["#fef2f2", "#f0fdf4", "#eff6ff"];
const statBorders = ["#fecaca", "#bbf7d0", "#bfdbfe"];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{story.meta.title}</title>
    <style>
      :root {
        --charcoal: #2d2a32;
        --muted: #6b7280;
        --warm: #faf8f5;
        --warm-light: #f5f2ed;
        --accent: #6b4c8a;
        --accent-light: #b08bd1;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        color: var(--charcoal);
        background: var(--warm-light);
        line-height: 1.6;
      }
      .site-header {
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        padding: 1rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        font-weight: 700;
        font-size: 0.875rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--accent);
      }
      .site-header nav { text-transform: none; letter-spacing: 0; font-weight: 400; }
      .site-header nav a { color: var(--muted); text-decoration: none; }
      .site-header nav a:hover { color: var(--accent); }
      .quick-nav {
        position: sticky;
        top: 0;
        z-index: 10;
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        padding: 0.75rem 1.5rem;
        display: flex;
        gap: 1.25rem;
        overflow-x: auto;
        font-size: 0.875rem;
      }
      .quick-nav a {
        color: var(--muted);
        text-decoration: none;
        white-space: nowrap;
      }
      .quick-nav a:hover { color: var(--accent); }
      .page-header {
        background: linear-gradient(135deg, #3d2a54 0%, #6b4c8a 100%);
        color: #fff;
        padding: 4rem 1.5rem 3rem;
      }
      .page-header-inner { max-width: 48rem; margin: 0 auto; }
      .page-header h1 {
        margin: 0 0 1rem;
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        line-height: 1.15;
        font-weight: 800;
      }
      .page-header p {
        margin: 0;
        font-size: 1.125rem;
        opacity: 0.92;
        max-width: 40rem;
      }
      .hero-visual {
        background: var(--warm-light);
        padding: 2.5rem 1.5rem;
      }
      .hero-visual-inner {
        max-width: 56rem;
        margin: 0 auto;
        background: linear-gradient(145deg, #e8e0f0, #d4c4e8);
        border-radius: 1rem;
        height: 14rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        font-weight: 600;
        box-shadow: 0 20px 40px rgba(107, 76, 138, 0.15);
      }
      .cta-row {
        background: var(--warm-light);
        padding: 0 1.5rem 2.5rem;
      }
      .cta-row-inner {
        max-width: 48rem;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.875rem 1.75rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
      }
      .btn-primary { background: #c5e84a; color: var(--charcoal); }
      .btn-secondary { background: #1f2937; color: #fff; }
      main { background: var(--warm); padding: 3rem 0 4rem; }
      .content { max-width: 48rem; margin: 0 auto; padding: 0 1.5rem; }
      section.block { margin-bottom: 4rem; scroll-margin-top: 5rem; }
      h2 {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 0 0 1.25rem;
        color: var(--charcoal);
      }
      .prose p {
        color: #374151;
        margin: 0 0 1rem;
        font-size: 1.0625rem;
      }
      .callout {
        font-weight: 600;
        color: var(--charcoal);
        font-size: 1.125rem;
        margin: 1.5rem 0;
      }
      .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem;
        margin: 2rem 0;
      }
      .stat {
        border-radius: 1rem;
        padding: 1.75rem 1.25rem;
        text-align: center;
        border: 1px solid;
      }
      .stat-value {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 0 0 0.5rem;
        line-height: 1;
      }
      .stat-label {
        font-size: 0.875rem;
        color: #374151;
        margin: 0 0 1rem;
      }
      .stat-source {
        font-size: 0.75rem;
        color: #9ca3af;
        border-top: 1px solid rgba(0,0,0,0.08);
        padding-top: 0.75rem;
        margin: 0;
      }
      .quote {
        display: flex;
        gap: 1.5rem;
        background: linear-gradient(135deg, #eff6ff, #f5f3ff);
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        padding: 2rem;
        margin: 2rem 0 3rem;
      }
      .quote-avatar {
        width: 5rem;
        height: 5rem;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent), var(--accent-light));
        flex-shrink: 0;
      }
      .quote-text {
        font-style: italic;
        color: var(--muted);
        font-size: 1.0625rem;
        margin: 0 0 1rem;
      }
      .quote-name { font-weight: 700; margin: 0; }
      .quote-title { font-size: 0.875rem; color: var(--muted); margin: 0.25rem 0 0; }
      .footer-cta {
        background: #fffbeb;
        border-top: 1px solid #fde68a;
        padding: 3rem 1.5rem;
      }
      .footer-cta-inner {
        max-width: 40rem;
        margin: 0 auto;
        text-align: center;
        background: #fff;
        border: 1px solid #fde68a;
        border-radius: 0.75rem;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
      }
      .footer-cta h3 { margin: 0 0 1.5rem; font-size: 1.5rem; }
      .site-footer {
        background: var(--charcoal);
        color: #9ca3af;
        text-align: center;
        padding: 1.5rem;
        font-size: 0.875rem;
      }
    </style>
  </head>
  <body>
    <div class="site-header">
      <strong>Impact Story Demo · JSON</strong>
      <nav>
        <a href="/riverdale-year-two/">Markdown example →</a>
      </nav>
    </div>

    <nav class="quick-nav" aria-label="Section navigation">
      <a href="#background">{story.sections.background.heading}</a>
      <a href="#challenge">{story.sections.challenge.heading}</a>
      <a href="#approach">{story.sections.approach.heading}</a>
      <a href="#result">{story.sections.result.heading}</a>
      <a href="#impact">{story.sections.impact.heading}</a>
    </nav>

    <header class="page-header">
      <div class="page-header-inner">
        <h1 {...edit("hero.title")}>{story.hero.title}</h1>
        <p {...edit("hero.intro")}>{story.hero.intro}</p>
      </div>
    </header>

    <div class="hero-visual">
      <div class="hero-visual-inner">Hero image placeholder</div>
    </div>

    <div class="cta-row">
      <div class="cta-row-inner">
        <a href="#" class="btn btn-primary">
          <span {...edit("ctaButtons.primary")}>{story.ctaButtons.primary}</span>
        </a>
        <a href="#" class="btn btn-secondary">
          <span {...edit("ctaButtons.secondary")}>{story.ctaButtons.secondary}</span>
        </a>
      </div>
    </div>

    <main>
      <div class="content">
        <section id="background" class="block">
          <h2 {...edit("sections.background.heading")}>{story.sections.background.heading}</h2>
          <div class="prose">
            {
              story.sections.background.paragraphs.map((paragraph, i) => (
                <p {...edit(`sections.background.paragraphs.${i}`)}>{paragraph}</p>
              ))
            }
          </div>
        </section>

        <section id="challenge" class="block">
          <h2 {...edit("sections.challenge.heading")}>{story.sections.challenge.heading}</h2>
          <div class="prose">
            {
              story.sections.challenge.paragraphs.map((paragraph, i) => (
                <p {...edit(`sections.challenge.paragraphs.${i}`)}>{paragraph}</p>
              ))
            }
            <p class="callout" {...edit("sections.challenge.callout")}>
              {story.sections.challenge.callout}
            </p>
          </div>

          <div class="stats">
            {
              story.stats.map((stat, i) => (
                <div
                  class="stat"
                  style={`background:${statColors[i]};border-color:${statBorders[i]}`}
                >
                  <p class="stat-value" {...edit(`stats.${i}.value`)}>{stat.value}</p>
                  <p class="stat-label" {...edit(`stats.${i}.label`)}>{stat.label}</p>
                  <p class="stat-source" {...edit(`stats.${i}.source`)}>{stat.source}</p>
                </div>
              ))
            }
          </div>

          <div class="prose">
            <p {...edit("sections.challenge.afterStats")}>{story.sections.challenge.afterStats}</p>
          </div>
        </section>

        <blockquote class="quote">
          <div class="quote-avatar" aria-hidden="true"></div>
          <div>
            <p class="quote-text" {...edit("quote.text")}>{story.quote.text}</p>
            <p class="quote-name" {...edit("quote.name")}>{story.quote.name}</p>
            <p class="quote-title" {...edit("quote.title")}>{story.quote.title}</p>
          </div>
        </blockquote>

        <section id="approach" class="block">
          <h2 {...edit("sections.approach.heading")}>{story.sections.approach.heading}</h2>
          <div class="prose">
            {
              story.sections.approach.paragraphs.map((paragraph, i) => (
                <p {...edit(`sections.approach.paragraphs.${i}`)}>{paragraph}</p>
              ))
            }
          </div>
        </section>

        <section id="result" class="block">
          <h2 {...edit("sections.result.heading")}>{story.sections.result.heading}</h2>
          <div class="prose">
            {
              story.sections.result.paragraphs.map((paragraph, i) => (
                <p {...edit(`sections.result.paragraphs.${i}`)}>{paragraph}</p>
              ))
            }
          </div>
        </section>

        <section id="impact" class="block">
          <h2 {...edit("sections.impact.heading")}>{story.sections.impact.heading}</h2>
          <div class="prose">
            {
              story.sections.impact.paragraphs.map((paragraph, i) => (
                <p {...edit(`sections.impact.paragraphs.${i}`)}>{paragraph}</p>
              ))
            }
          </div>
        </section>
      </div>
    </main>

    <section class="footer-cta">
      <div class="footer-cta-inner">
        <h3 {...edit("footerCta.title")}>{story.footerCta.title}</h3>
        <div class="cta-row-inner">
          <a href="#" class="btn btn-primary">{story.ctaButtons.primary}</a>
          <a href="#" class="btn btn-secondary">{story.ctaButtons.secondary}</a>
        </div>
      </div>
    </section>

    <footer class="site-footer">Demo page for astro-inline-editor · dev only</footer>
  </body>
</html>
