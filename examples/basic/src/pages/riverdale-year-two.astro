---
import raw from "../content/riverdale-year-two.md?raw";
import { parseMdDocument, parseBodySections } from "@heyupstart/astro-inline-editor";
import { contentEdit } from "@heyupstart/astro-inline-editor";

const FILE = "src/content/riverdale-year-two.md";
const doc = parseMdDocument(raw);
const fm = doc.frontmatter;
const sections = parseBodySections(doc.body);
const edit = (path, html = false) => contentEdit(FILE, path, html);

const statColors = ["#fef2f2", "#f0fdf4", "#eff6ff"];
const statBorders = ["#fecaca", "#bbf7d0", "#bfdbfe"];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fm.meta.title}</title>
    <style>
      :root {
        --charcoal: #2d2a32;
        --muted: #6b7280;
        --warm: #faf8f5;
        --warm-light: #f5f2ed;
        --accent: #6b4c8a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        color: var(--charcoal);
        background: var(--warm-light);
        line-height: 1.6;
      }
      .site-header {
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        padding: 1rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        font-size: 0.875rem;
      }
      .site-header strong { color: var(--accent); text-transform: uppercase; letter-spacing: 0.04em; }
      .site-header nav { display: flex; gap: 1rem; }
      .site-header a { color: var(--muted); text-decoration: none; }
      .site-header a:hover { color: var(--accent); }
      .format-badge {
        display: inline-block;
        background: #ede9fe;
        color: #5b21b6;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        margin-bottom: 0.75rem;
      }
      .page-header {
        background: linear-gradient(135deg, #3d2a54 0%, #6b4c8a 100%);
        color: #fff;
        padding: 3.5rem 1.5rem 2.5rem;
      }
      .page-header-inner { max-width: 48rem; margin: 0 auto; }
      .page-header h1 { margin: 0 0 1rem; font-size: clamp(1.75rem, 4vw, 2.25rem); line-height: 1.15; font-weight: 800; }
      .page-header p { margin: 0; font-size: 1.0625rem; opacity: 0.92; max-width: 40rem; }
      main { max-width: 48rem; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
      .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin: 2rem 0;
      }
      .stat { border-radius: 1rem; padding: 1.5rem 1rem; text-align: center; border: 1px solid; }
      .stat-value { font-size: 2rem; font-weight: 800; margin: 0 0 0.35rem; line-height: 1; }
      .stat-label { font-size: 0.8125rem; color: #374151; margin: 0 0 0.75rem; }
      .stat-source { font-size: 0.6875rem; color: #9ca3af; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 0.5rem; margin: 0; }
      .quote {
        background: linear-gradient(135deg, #eff6ff, #f5f3ff);
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        padding: 1.75rem;
        margin: 2rem 0;
      }
      .quote-text { font-style: italic; color: var(--muted); margin: 0 0 1rem; }
      .quote-name { font-weight: 700; margin: 0; }
      .quote-title { font-size: 0.875rem; color: var(--muted); margin: 0.25rem 0 0; }
      .prose h2 { font-size: 1.5rem; font-weight: 800; margin: 2rem 0 0.75rem; color: var(--charcoal); }
      .prose p { color: #374151; margin: 0 0 1rem; }
      .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 0.75rem 1.5rem; border-radius: 0.5rem; font-weight: 600;
        font-size: 0.9375rem; text-decoration: none;
      }
      .btn-primary { background: #c5e84a; color: var(--charcoal); }
      .btn-secondary { background: #1f2937; color: #fff; }
      .file-hint {
        margin-top: 2rem;
        padding: 1rem 1.25rem;
        background: #fff;
        border: 1px dashed #d1d5db;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        color: var(--muted);
      }
      .file-hint code { font-size: 0.8125rem; color: var(--charcoal); }
    </style>
  </head>
  <body>
    <div class="site-header">
      <strong>Impact Story Demo · Markdown</strong>
      <nav>
        <a href="/">Home</a>
        <a href="/riverdale/">JSON example</a>
      </nav>
    </div>

    <header class="page-header">
      <div class="page-header-inner">
        <span class="format-badge">src/content/riverdale-year-two.md</span>
        <h1 {...edit("hero.title")}>{fm.hero.title}</h1>
        <p {...edit("hero.intro")}>{fm.hero.intro}</p>
      </div>
    </header>

    <main>
      <div class="stats">
        {
          fm.stats.map((stat, i) => (
            <div class="stat" style={`background:${statColors[i]};border-color:${statBorders[i]}`}>
              <p class="stat-value" {...edit(`stats.${i}.value`)}>{stat.value}</p>
              <p class="stat-label" {...edit(`stats.${i}.label`)}>{stat.label}</p>
              <p class="stat-source" {...edit(`stats.${i}.source`)}>{stat.source}</p>
            </div>
          ))
        }
      </div>

      <blockquote class="quote">
        <p class="quote-text" {...edit("quote.text")}>{fm.quote.text}</p>
        <p class="quote-name" {...edit("quote.name")}>{fm.quote.name}</p>
        <p class="quote-title" {...edit("quote.title")}>{fm.quote.title}</p>
      </blockquote>

      <div class="prose">
        {
          sections.map((section, si) => (
            <section>
              <h2 {...edit(`body.${si}.heading`)}>{section.heading}</h2>
              {
                section.paragraphs.map((paragraph, pi) => (
                  <p {...edit(`body.${si}.paragraphs.${pi}`)}>{paragraph}</p>
                ))
              }
            </section>
          ))
        }
      </div>

      <div class="cta-row">
        <a href="/" class="btn btn-primary">
          <span {...edit("cta.primary")}>{fm.cta.primary}</span>
        </a>
        <a href="#" class="btn btn-secondary">
          <span {...edit("cta.secondary")}>{fm.cta.secondary}</span>
        </a>
      </div>

      <p class="file-hint">
        Paste new <code>##</code> sections in <code>{FILE}</code>, then refresh. Headings,
        paragraphs, and frontmatter fields tagged on this page save from the inline editor.
      </p>
    </main>
  </body>
</html>
